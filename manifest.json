{
  "manifest_version": 3,
  "name": "Unseen: Email Tracker Blocker",
  "short_name": "Unseen",
  "version": "0.2.1",
  "description": "Blocks email tracking pixels in Gmail, so senders can't see when you open their emails. Runs only on Gmail.",
  "homepage_url": "https://laboskiriste.github.io/unseen/",
  "minimum_chrome_version": "121",
  "permissions": ["declarativeNetRequest", "storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/trackers-data.js", "src/classify.js", "src/pro.js", "src/links.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "gmail_proxy", "enabled": true, "path": "src/rules.json" }]
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
